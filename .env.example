# LLM Provider Configuration (Groq is 100% free with no credit card required)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configurations
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# PostgreSQL Database Connection (Supabase read-only role)
# Format: postgresql://pipeline_reader:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://pipeline_reader:reader_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Bearer Token Authentication (Used by Shark / API Clients)
# Unhashed token given to Shark/client
API_BEARER_TOKEN=pipeline-guardian-secure-test-token-2026
# SHA-256 hash of API_BEARER_TOKEN (validated in constant-time by FastAPI)
API_BEARER_TOKEN_HASH=88e1467ea309bcab2a3c9f28d88b4dd204859a11fa523fbb55655a3b934757c2

# App Environment
ENVIRONMENT=development
PORT=8000

